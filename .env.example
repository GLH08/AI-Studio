# ================================
# AI Studio - Environment Configuration
# ================================
# Only the variables below are read by the app. Copy to `.env` and fill in.

# ================================
# Provider Configuration (up to 10 providers: PROVIDER_1_* … PROVIDER_10_*)
# Required per provider: NAME, TYPE, BASE_URL, API_KEY, MODELS. TYPE is one of
# openai | openai-compatible | gemini. Incomplete providers are skipped.
# ================================

# Provider 1: Standard OpenAI
PROVIDER_1_NAME=OpenAI DALL·E
PROVIDER_1_TYPE=openai
PROVIDER_1_BASE_URL=https://api.openai.com/v1
PROVIDER_1_API_KEY=sk-xxxx
PROVIDER_1_MODELS=dall-e-3,dall-e-2,gpt-image-1

# Provider 2: OpenAI Compatible (Reverse Proxy — Chat Completions, extracts image URLs from markdown)
#PROVIDER_2_NAME=Reverse Chat API
#PROVIDER_2_TYPE=openai-compatible
#PROVIDER_2_BASE_URL=https://your-reverse-proxy.com/v1
#PROVIDER_2_API_KEY=sk-xxxx
#PROVIDER_2_MODELS=gpt-4o,gpt-4o-mini

# Provider 3: Google Gemini
#PROVIDER_3_NAME=Google Gemini
#PROVIDER_3_TYPE=gemini
#PROVIDER_3_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#PROVIDER_3_API_KEY=AIzaSyXXXX
#PROVIDER_3_MODELS=gemini-2.0-flash-exp

# ================================
# Server
# ================================

# Server port (default: 8787)
PORT=8787

# Number of reverse-proxy hops to trust for the real client IP (rate limiting).
# 1 = one proxy (nginx/Cloudflare). 0 = directly exposed. (default: 1)
TRUST_PROXY=1

# Override the JSON DB path (default: data/db.json). Mainly used by tests.
#DB_FILE=

# ================================
# Chevereto Image Hosting (optional — re-hosts generated media on a CDN)
# ================================

CHEVERETO_URL=https://chevereto.example.com
CHEVERETO_API_KEY=
# Optional album to upload into
CHEVERETO_ALBUM_ID=

# ================================
# Authentication (optional)
# ================================

# If set, the whole app requires login. Leave empty to run open.
AUTH_PASSWORD=your_secure_password_here

# Max login attempts per 15 min before 429 (default: 10)
LOGIN_RATE_LIMIT_MAX=10

# ================================
# Security
# ================================

# SSRF allow-list for the media proxies and manual add/collection endpoints:
# comma-separated hostnames. EMPTY = allow all public hosts (private/loopback/
# link-local IPs are always blocked). Set this in production to lock proxying
# to known media hosts (e.g. your Chevereto domain).
IMAGE_PROXY_WHITELIST=

# Global API rate limit (applies to /api/*, except the video proxy).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# ================================
# Video Generation (async polling; Grok-style /videos/generations)
# Keep the timeout under Cloudflare's ~100s edge limit if proxied through CF.
# ================================

VIDEO_POLL_INTERVAL_MS=3000
VIDEO_POLL_TIMEOUT_MS=90000
